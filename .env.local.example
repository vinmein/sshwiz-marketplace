# Firebase web-app config for local development (Project settings → General →
# Your apps → Web app). These values are public; rules enforce security.
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_APP_ID=

# Base64 of an Admin SDK service-account key, used by scripts/make-admin.mjs
# (NOT by the web app). Generate: Project settings → Service accounts →
# Generate new private key, then: base64 -i <key>.json | tr -d '\n'
# This is a SECRET — .env.local and *-firebase-adminsdk-*.json are gitignored;
# keep it that way.
FB_SERVICE_ACCOUNT_B64=

# Public site details. NEXT_PUBLIC_SITE_URL is the origin this environment is
# served from (no trailing slash) — it feeds canonical URLs and the absolute
# Support/Privacy URLs used in store listings. The two addresses appear on
# /support and /privacy; leave them blank to fall back to the placeholders in
# lib/site.ts.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
