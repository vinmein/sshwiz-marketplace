rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The app reads these anonymously, but only rows that are published —
    // its query filters on published == true, which is what makes the list
    // rule provable. Admins see and edit everything from the portal.
    match /packages/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /scripts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Admin allowlist: create these documents from the Firebase console
    // (doc ID = the user's Auth UID). Users can only check their own entry;
    // nobody can grant themselves admin through the client.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
